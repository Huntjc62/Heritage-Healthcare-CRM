rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function activeUser() {
      return signedIn() && profile().active == true;
    }

    function admin() {
      return activeUser() && profile().role == "admin";
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      allow create, update, delete: if admin();
    }

    match /enquiries/{id} {
      allow read: if admin()
        || (activeUser() && resource.data.office == profile().office);

      allow create: if admin()
        || (
          activeUser()
          && request.resource.data.office == profile().office
          && request.resource.data.createdBy == request.auth.token.email
        );

      allow update: if admin()
        || (
          activeUser()
          && resource.data.office == profile().office
          && request.resource.data.office == resource.data.office
          && request.resource.data.lastEditedBy == request.auth.token.email
        );

      allow delete: if admin();
    }

    match /offices/{id} {
      allow read: if activeUser();
      allow write: if admin();
    }

    match /analytics/{id} {
      allow read: if activeUser();
      allow write: if admin();
    }

    match /reports/{id} {
      allow read: if activeUser();
      allow write: if admin();
    }

    match /notifications/{id} {
      allow read: if activeUser();
      allow write: if admin();
    }

    match /tasks/{id} {
      allow read: if admin()
        || (activeUser() && resource.data.office == profile().office);
      allow create: if activeUser()
        && request.resource.data.office == profile().office;
      allow update, delete: if admin()
        || (activeUser() && resource.data.office == profile().office);
    }

    match /documents/{id} {
      allow read: if activeUser();
      allow write: if admin();
    }

    match /marketing/{id} {
      allow read: if activeUser();
      allow write: if admin();
    }
  }
}
